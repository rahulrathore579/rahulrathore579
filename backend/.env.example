# ============================
# Backend Environment Variables
# ============================

# MongoDB Connection (use MongoDB Atlas for production)
# Format: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/personal_assistant
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/personal_assistant

# JWT Secret - use a long, random string in production
JWT_SECRET=change-this-to-a-long-random-secret-string

# Google Gemini API Key
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Flask Environment
FLASK_ENV=production

# Server Port (Render sets this automatically)
PORT=5000

# CORS Allowed Origins (comma-separated, your Vercel URL)
# e.g. https://your-portfolio.vercel.app,https://rahulrathore579.vercel.app
ALLOWED_ORIGINS=https://rahulrathore579.vercel.app
